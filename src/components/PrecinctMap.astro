---
import boundaryData from '../data/boundary.json';
import precinctData from '../data/precincts.json';
import precincts2026 from '../data/precincts-2026.json';
import election2025 from '../data/election-data-template.json';
import election2026 from '../data/election-2026.json';

interface Props {
  mapboxToken: string;
}

const { mapboxToken } = Astro.props;
---

<div id="map" class="map-container"></div>

<!-- Back Button -->
<a href="/" class="back-btn" title="Back to Home">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M19 12H5M12 19l-7-7 7-7"></path>
  </svg>
</a>

<!-- Sidebar -->
<div class="sidebar election-sidebar" id="sidebar">
  <div class="sidebar-header">
    <h2>Election Results</h2>
    <button id="sidebar-close" class="sidebar-close-btn" title="Close sidebar">×</button>
  </div>

  <div class="sidebar-content">
    <!-- Compare Mode Toggle -->
    <div class="sidebar-section">
      <button id="compare-toggle" class="sidebar-btn compare-toggle-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
        <span id="compare-toggle-text">Enable Compare Mode</span>
      </button>
    </div>

    <!-- Normal Mode Selector -->
    <div id="normal-selector" class="sidebar-section">
      <label class="sidebar-label" for="year-select">Election</label>
      <select id="year-select" class="sidebar-select"></select>

      <label class="sidebar-label sidebar-label-spaced" for="race-select">Race</label>
      <select id="race-select" class="sidebar-select"></select>

      <label class="sidebar-label sidebar-label-spaced" for="candidate-select">Color Precincts By</label>
      <select id="candidate-select" class="sidebar-select"></select>
    </div>

    <!-- Compare Mode Selectors -->
    <div id="compare-selectors" class="sidebar-section hidden">
      <div class="compare-section">
        <label class="sidebar-label">Selection 1</label>
        <select id="compare-year-1" class="sidebar-select"></select>
        <select id="compare-race-1" class="sidebar-select"></select>
        <select id="compare-candidate-1" class="sidebar-select"></select>
      </div>

      <div class="compare-divider">
        <span>VS</span>
      </div>

      <div class="compare-section">
        <label class="sidebar-label">Selection 2</label>
        <select id="compare-year-2" class="sidebar-select"></select>
        <select id="compare-race-2" class="sidebar-select"></select>
        <select id="compare-candidate-2" class="sidebar-select"></select>
      </div>

      <label class="sidebar-label sidebar-label-spaced" for="compare-metric">Compare By</label>
      <select id="compare-metric" class="sidebar-select">
        <option value="share">Vote share (% of race)</option>
        <option value="votes">Raw votes</option>
      </select>
    </div>

    <!-- Legend -->
    <div class="sidebar-section" id="election-legend">
      <label class="sidebar-label" id="legend-title"></label>
      <div id="legend-items" class="legend-items">
        <!-- Dynamically populated -->
      </div>
      <div class="legend-note">Click a precinct for details</div>
    </div>

    <!-- Vote Totals -->
    <div class="sidebar-section" id="stats-panel">
      <label class="sidebar-label" id="vote-totals-title">Vote Totals</label>
      <div id="vote-totals" class="vote-totals-sidebar">
        <!-- Dynamically populated with candidate vote totals -->
      </div>
    </div>
  </div>
</div>

<!-- Sidebar Toggle Button (Mobile) -->
<button id="sidebar-toggle" class="sidebar-toggle-btn" title="Show filters">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <line x1="4" y1="6" x2="20" y2="6"></line>
    <line x1="4" y1="12" x2="20" y2="12"></line>
    <line x1="4" y1="18" x2="20" y2="18"></line>
  </svg>
</button>

<div class="attribution">
  Data from <a href="https://dearborn.gov/sites/default/files/2026-11/11-3-26%20Election%20Precinct%20Breakdown.pdf" target="_blank">City of Dearborn</a> &amp; <a href="https://www.michigan.gov/sos" target="_blank">Michigan SOS</a>
</div>

<script is:inline define:vars={{ mapboxToken, boundaryData, precinctData, precincts2026, election2025, election2026 }}>
  const MAPBOX_TOKEN = mapboxToken;

  // ---------------------------------------------------------------------------
  // Elections
  // ---------------------------------------------------------------------------

  // Colors for the 2025 municipal races (the 2026 file carries its own colors).
  const colors2025 = {
    "Abdullah Hammoud": "#2ecc71",
    "Nagi Almudhegi": "#e74c3c",
    "George Darany": "#3498db",
    "Sami Elhady": "#9b59b6",
    "Robert A. Abraham": "#e74c3c",
    "Mubarek Ahmed": "#2ecc71",
    "Othman Ali Alaansi": "#3498db",
    "Kamal Alsawafy": "#9b59b6",
    "Mark Andrew": "#f39c12",
    "Sharon Dulmage": "#1abc9c",
    "Gary A. Enos": "#e91e63",
    "Mustapha Hammoud": "#00bcd4",
    "Shadi Mawari": "#ff5722",
    "Devon O'Reilly": "#8bc34a",
    "Ahmad Othman": "#673ab7",
    "Ken Paris": "#ffc107",
    "Michael T. Sareini": "#607d8b",
    "yes": "#2ecc71",
    "no": "#e74c3c"
  };

  // Precinct boundaries. 2025 results use combined precincts (e.g. "8-9");
  // 2026 reports most of those separately.
  const GEOMETRIES = {
    merged: precinctData,
    '2026': precincts2026
  };

  // Year -> { label, geometry, races, mergedUnits? }.
  // Each race: { race_name, category, seats, candidates, colors, precincts }.
  // mergedUnits maps a precinct to its combined "merged" unit, so the year can be
  // summed onto the merged boundaries when compared against another year.
  const ELECTIONS = {
    '2026': {
      label: 'Nov 2026 General',
      geometry: '2026',
      mergedUnits: election2026.merged_units,
      races: election2026.races
    },
    '2025': {
      label: 'Nov 2025 Municipal',
      geometry: 'merged',
      races: Object.fromEntries(Object.entries(election2025.races).map(([key, race]) => [key, {
        ...race,
        category: race.race_name.startsWith('Proposal') ? 'Proposals' : 'City',
        colors: Object.fromEntries(race.candidates.map(c => [c, colors2025[c] || '#888888']))
      }]))
    }
  };
  const YEARS = Object.keys(ELECTIONS).sort().reverse();

  const DEFAULT_RACE = { '2026': 'governor', '2025': 'mayor' };

  // A "selection" is { year, race, candidate }; candidate === null means "precinct winner".
  let current = { year: '2026', race: 'governor', candidate: null };
  let compareMode = false;
  let compareMetric = 'share';
  let compare1 = { year: '2026', race: 'governor', candidate: null };
  let compare2 = { year: '2025', race: 'mayor', candidate: null };

  let map;
  let currentPopup = null;
  let shownGeometry = null;

  function getRace(sel) {
    return ELECTIONS[sel.year]?.races[sel.race] || null;
  }

  // Boundaries currently drawn. Comparing two different years falls back to the
  // merged boundaries so both sides cover the same area.
  function activeGeometry() {
    if (!compareMode) return ELECTIONS[current.year].geometry;
    const g1 = ELECTIONS[compare1.year].geometry;
    const g2 = ELECTIONS[compare2.year].geometry;
    return g1 === g2 ? g1 : 'merged';
  }

  // Results and turnout for one drawn precinct, summing finer precincts if needed.
  function getEntry(sel, unitId) {
    const election = ELECTIONS[sel.year];
    const race = getRace(sel);
    if (!race) return null;
    const geom = activeGeometry();
    if (election.geometry === geom) return race.precincts[unitId] || null;
    if (geom !== 'merged' || !election.mergedUnits) return null;

    const members = Object.keys(race.precincts).filter(p => election.mergedUnits[p] === unitId);
    if (members.length === 0) return null;
    const entry = { results: {}, registered_voters: 0, ballots_cast: 0, members };
    for (const p of members) {
      const src = race.precincts[p];
      entry.registered_voters += src.registered_voters || 0;
      entry.ballots_cast += src.ballots_cast || 0;
      for (const [c, v] of Object.entries(src.results)) entry.results[c] = (entry.results[c] || 0) + v;
    }
    entry.precinct_name = `Dearborn ${members.join(' & ')}`;
    return entry;
  }

  function getResults(sel, unitId) {
    return getEntry(sel, unitId)?.results || null;
  }

  function candidateColor(sel, candidate) {
    return getRace(sel)?.colors?.[candidate] || '#888888';
  }

  function raceLabel(sel) {
    const race = getRace(sel);
    return race ? `${sel.year} ${race.race_name}` : '';
  }

  function sumVotes(results) {
    return Object.values(results).reduce((sum, v) => sum + v, 0);
  }

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
  }

  // ---------------------------------------------------------------------------
  // Color helpers
  // ---------------------------------------------------------------------------

  function getWinnerWithMargin(results) {
    if (!results) return null;
    const sorted = Object.entries(results).sort((a, b) => b[1] - a[1]);
    if (sorted.length === 0) return null;
    const totalVotes = sumVotes(results);
    const winnerVotes = sorted[0][1];
    const secondVotes = sorted.length > 1 ? sorted[1][1] : 0;
    return {
      name: sorted[0][0],
      votes: winnerVotes,
      margin: totalVotes > 0 ? (winnerVotes - secondVotes) / totalVotes : 0,
      totalVotes
    };
  }

  // Low intensity = washed out toward white, high intensity = darker.
  function adjustColorForMargin(hexColor, margin) {
    const r = parseInt(hexColor.slice(1, 3), 16);
    const g = parseInt(hexColor.slice(3, 5), 16);
    const b = parseInt(hexColor.slice(5, 7), 16);
    if (margin < 0.5) {
      const whiteness = (0.5 - margin) * 1.6;
      return `rgb(${Math.round(r + (255 - r) * whiteness)}, ${Math.round(g + (255 - g) * whiteness)}, ${Math.round(b + (255 - b) * whiteness)})`;
    }
    const darkness = (margin - 0.5) * 0.8;
    return `rgb(${Math.round(r * (1 - darkness))}, ${Math.round(g * (1 - darkness))}, ${Math.round(b * (1 - darkness))})`;
  }

  function getVoteShare(results, candidate) {
    if (!results) return 0;
    const total = sumVotes(results);
    return total > 0 ? (results[candidate] || 0) / total : 0;
  }

  function getPrecinctColor(sel, precinctId) {
    const results = getResults(sel, precinctId);
    if (!results || sumVotes(results) === 0) return '#333333';
    if (sel.candidate) {
      return adjustColorForMargin(candidateColor(sel, sel.candidate), getVoteShare(results, sel.candidate));
    }
    const winner = getWinnerWithMargin(results);
    return adjustColorForMargin(candidateColor(sel, winner.name), winner.margin);
  }

  // Value used in compare mode: vote share (0-1) or raw votes.
  function compareValue(sel, precinctId) {
    const results = getResults(sel, precinctId);
    if (!results) return null;
    return compareMetric === 'share' ? getVoteShare(results, sel.candidate) : (results[sel.candidate] || 0);
  }

  function getComparisonColor(precinctId) {
    const v1 = compareValue(compare1, precinctId);
    const v2 = compareValue(compare2, precinctId);
    if (v1 === null || v2 === null) return '#333333';
    const diff = v1 - v2;
    if (diff === 0) return '#666666';
    // Share: a 33-point gap is full intensity. Votes: relative difference.
    const intensity = compareMetric === 'share'
      ? Math.min(Math.abs(diff) * 3, 1)
      : Math.min(Math.abs(diff) / Math.max(v1, v2, 1) * 1.5, 1);
    return adjustColorForMargin(diff > 0 ? '#3498db' : '#e67e22', intensity);
  }

  function formatDiff(diff) {
    if (compareMetric === 'share') {
      const pts = (diff * 100).toFixed(1);
      return `${diff > 0 ? '+' : ''}${pts} pts`;
    }
    return `${diff > 0 ? '+' : ''}${diff.toLocaleString()} votes`;
  }

  // ---------------------------------------------------------------------------
  // Pie chart
  // ---------------------------------------------------------------------------

  function generatePieChart(sel, results, size = 100) {
    const sorted = Object.entries(results).filter(([_, v]) => v > 0).sort((a, b) => b[1] - a[1]);
    const total = sorted.reduce((sum, [_, v]) => sum + v, 0);
    if (total === 0) return '';

    const c = size / 2;
    const radius = size / 2 - 2;
    if (sorted.length === 1) {
      return `<svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}"><circle cx="${c}" cy="${c}" r="${radius}" fill="${candidateColor(sel, sorted[0][0])}" stroke="#000" stroke-width="1"/></svg>`;
    }

    let angle = -90;
    const paths = sorted.map(([candidate, votes]) => {
      const sweep = (votes / total) * 360;
      const start = (angle * Math.PI) / 180;
      const end = ((angle + sweep) * Math.PI) / 180;
      angle += sweep;
      const x1 = c + radius * Math.cos(start), y1 = c + radius * Math.sin(start);
      const x2 = c + radius * Math.cos(end), y2 = c + radius * Math.sin(end);
      return `<path d="M ${c} ${c} L ${x1} ${y1} A ${radius} ${radius} 0 ${sweep > 180 ? 1 : 0} 1 ${x2} ${y2} Z" fill="${candidateColor(sel, candidate)}" stroke="#000" stroke-width="1"/>`;
    });
    return `<svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">${paths.join('')}</svg>`;
  }

  // ---------------------------------------------------------------------------
  // Sidebar rendering
  // ---------------------------------------------------------------------------

  function getRaceTotals(sel) {
    const totals = {};
    const race = getRace(sel);
    if (!race) return totals;
    race.candidates.forEach(c => { totals[c] = 0; });
    for (const p of Object.values(race.precincts)) {
      for (const [c, v] of Object.entries(p.results)) totals[c] = (totals[c] || 0) + v;
    }
    return totals;
  }

  function updateVoteTotals() {
    const div = document.getElementById('vote-totals');
    const title = document.getElementById('vote-totals-title');
    const statsPanel = document.getElementById('stats-panel');

    if (compareMode) {
      const sides = [[compare1, '#3498db'], [compare2, '#e67e22']].filter(([sel]) => sel.candidate);
      if (sides.length === 0) {
        statsPanel.classList.add('compare-mode');
        div.innerHTML = '';
        return;
      }
      statsPanel.classList.remove('compare-mode');
      title.textContent = 'Citywide';
      div.innerHTML = sides.map(([sel, color]) => {
        const totals = getRaceTotals(sel);
        const grand = sumVotes(totals);
        const votes = totals[sel.candidate] || 0;
        const pct = grand > 0 ? ((votes / grand) * 100).toFixed(1) : '0.0';
        return `
          <div class="vote-total-row">
            <span class="candidate-color" style="background: ${color}"></span>
            <span class="candidate-name">${escapeHtml(sel.candidate)}<span class="candidate-race">${escapeHtml(raceLabel(sel))}</span></span>
            <span class="candidate-votes">${votes.toLocaleString()} <span class="pct">(${pct}%)</span></span>
          </div>`;
      }).join('');
      return;
    }

    statsPanel.classList.remove('compare-mode');
    title.textContent = 'Citywide Vote Totals';
    const totals = getRaceTotals(current);
    const sorted = Object.entries(totals).sort((a, b) => b[1] - a[1]);
    const grand = sorted.reduce((sum, [_, v]) => sum + v, 0);
    const seats = getRace(current)?.seats || 1;

    div.innerHTML = sorted.map(([candidate, votes], idx) => {
      const pct = grand > 0 ? ((votes / grand) * 100).toFixed(1) : '0.0';
      return `
        <div class="vote-total-row ${idx < seats ? 'leader' : ''}">
          <span class="candidate-color" style="background: ${candidateColor(current, candidate)}"></span>
          <span class="candidate-name">${escapeHtml(candidate)}</span>
          <span class="candidate-votes">${votes.toLocaleString()} <span class="pct">(${pct}%)</span></span>
        </div>`;
    }).join('') + (seats > 1 ? `<div class="legend-note">Vote for ${seats}; percentages are of all votes cast in the race.</div>` : '');
  }

  function updateLegend() {
    const items = document.getElementById('legend-items');
    const title = document.getElementById('legend-title');

    if (compareMode) {
      title.textContent = 'Comparison';
      if (!compare1.candidate || !compare2.candidate) {
        items.innerHTML = '<div class="legend-note">Pick a candidate or option on both sides to compare.</div>';
        return;
      }
      const metricNote = compareMetric === 'share' ? 'higher vote share' : 'more votes';
      items.innerHTML = `
        <div class="legend-item">
          <span class="legend-dot" style="background: #3498db"></span>
          <span>${escapeHtml(compare1.candidate)} (${escapeHtml(raceLabel(compare1))}) ${metricNote}</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background: #e67e22"></span>
          <span>${escapeHtml(compare2.candidate)} (${escapeHtml(raceLabel(compare2))}) ${metricNote}</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background: #666666"></span>
          <span>Equal</span>
        </div>
        <div class="legend-note" style="margin-top: 0.5rem;">Darker = larger difference</div>` +
        (compare1.year !== compare2.year
          ? '<div class="legend-note">Comparing different years: 2026 precincts are combined to match 2025 boundaries (e.g. 8 + 9).</div>'
          : '');
      return;
    }

    const race = getRace(current);
    if (!race) return;

    if (current.candidate) {
      title.textContent = current.candidate;
      const totals = getRaceTotals(current);
      const grand = sumVotes(totals);
      const avg = grand > 0 ? ((totals[current.candidate] || 0) / grand * 100).toFixed(1) : '0.0';
      const color = candidateColor(current, current.candidate);
      items.innerHTML = `
        <div class="legend-item">
          <span class="legend-dot" style="background: ${adjustColorForMargin(color, 0.85)}"></span>
          <span>High support</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background: ${adjustColorForMargin(color, 0.2)}"></span>
          <span>Low support</span>
        </div>
        <div class="legend-note" style="margin-top: 0.5rem;">Citywide: ${avg}% — ${escapeHtml(raceLabel(current))}</div>`;
      return;
    }

    title.textContent = raceLabel(current);
    items.innerHTML = race.candidates.map(c => `
      <div class="legend-item">
        <span class="legend-dot" style="background: ${candidateColor(current, c)}"></span>
        <span>${escapeHtml(c)}</span>
      </div>`).join('') +
      '<div class="legend-note" style="margin-top: 0.5rem;">Colored by precinct winner; darker = wider margin</div>';
  }

  function updateMapColors() {
    if (!map || !map.getSource('precincts')) return;
    const geom = activeGeometry();
    if (geom !== shownGeometry) {
      map.getSource('precincts').setData(GEOMETRIES[geom]);
      shownGeometry = geom;
    }
    const expr = ['case'];
    GEOMETRIES[geom].features.forEach(feature => {
      const id = feature.properties.PRECINCT;
      const color = compareMode
        ? (compare1.candidate && compare2.candidate ? getComparisonColor(id) : '#333333')
        : getPrecinctColor(current, id);
      expr.push(['==', ['get', 'PRECINCT'], id], color);
    });
    expr.push('#333333');
    map.setPaintProperty('precinct-fill', 'fill-color', expr);
  }

  function refresh() {
    updateLegend();
    updateVoteTotals();
    updateMapColors();
    if (currentPopup) currentPopup.remove();
  }

  // ---------------------------------------------------------------------------
  // Popups
  // ---------------------------------------------------------------------------

  function showPopup(lngLat, precinctId, props = {}) {
    if (currentPopup) currentPopup.remove();

    if (compareMode && compare1.candidate && compare2.candidate) {
      const rows = [[compare1, '#3498db'], [compare2, '#e67e22']].map(([sel, color]) => {
        const results = getResults(sel, precinctId);
        const votes = results ? (results[sel.candidate] || 0) : 0;
        const pct = results ? getVoteShare(results, sel.candidate) : 0;
        return `
          <div class="compare-row">
            <span class="candidate-color" style="background: ${color}"></span>
            <span class="label">${escapeHtml(sel.candidate)}<span class="candidate-race">${escapeHtml(raceLabel(sel))}</span></span>
            <span class="value">${votes.toLocaleString()} <span class="votes">(${(pct * 100).toFixed(1)}%)</span></span>
          </div>`;
      }).join('');
      const v1 = compareValue(compare1, precinctId) ?? 0;
      const v2 = compareValue(compare2, precinctId) ?? 0;
      const diff = v1 - v2;
      const winnerColor = diff > 0 ? '#3498db' : (diff < 0 ? '#e67e22' : '#666');

      currentPopup = new mapboxgl.Popup({ maxWidth: '350px' })
        .setLngLat(lngLat)
        .setHTML(`
          <div class="popup-title">Precinct ${escapeHtml(precinctId)}</div>
          <div class="popup-subtitle">Comparison</div>
          <div class="popup-compare">
            ${rows}
            <div class="compare-diff" style="border-left-color: ${winnerColor}">
              <span class="diff-label">Difference:</span>
              <span class="diff-value" style="color: ${winnerColor}">${formatDiff(compareMetric === 'share' ? diff : Math.round(diff))}</span>
            </div>
          </div>`)
        .addTo(map);
      return;
    }

    const results = getResults(current, precinctId);
    const meta = getEntry(current, precinctId);
    let resultsHtml = '<div class="popup-note">No data available</div>';
    let pieChartHtml = '';

    if (results) {
      const sorted = Object.entries(results).sort((a, b) => b[1] - a[1]);
      const total = sumVotes(results);
      pieChartHtml = generatePieChart(current, results, 120);
      resultsHtml = sorted.map(([candidate, votes], idx) => {
        const pct = total > 0 ? ((votes / total) * 100).toFixed(1) : '0.0';
        const highlight = current.candidate ? candidate === current.candidate : idx === 0;
        return `
          <div class="popup-row ${highlight ? 'winner' : ''}">
            <span class="candidate-color" style="background: ${candidateColor(current, candidate)}"></span>
            <span class="label">${escapeHtml(candidate)}</span>
            <span class="value">${votes.toLocaleString()} <span class="pct">(${pct}%)</span></span>
          </div>`;
      }).join('');
    }

    const notes = [];
    if (meta?.registered_voters) notes.push(`Registered voters: ${meta.registered_voters.toLocaleString()}`);
    if (meta?.ballots_cast) notes.push(`Ballots cast: ${meta.ballots_cast.toLocaleString()}`);
    if (meta?.precinct_name && meta.precinct_name.includes('&')) notes.push(`Includes ${escapeHtml(meta.precinct_name)}`);
    if (props.Boundary_Note) notes.push(`Boundary: ${escapeHtml(props.Boundary_Note)}`);

    currentPopup = new mapboxgl.Popup({ maxWidth: '320px' })
      .setLngLat(lngLat)
      .setHTML(`
        <div class="popup-title">Precinct ${escapeHtml(precinctId)}</div>
        <div class="popup-subtitle">${escapeHtml(raceLabel(current))}</div>
        <div class="popup-chart">${pieChartHtml}</div>
        <div class="popup-results">${resultsHtml}</div>
        ${notes.map(n => `<div class="popup-note">${n}</div>`).join('')}`)
      .addTo(map);
  }

  // ---------------------------------------------------------------------------
  // Map
  // ---------------------------------------------------------------------------

  function initMap() {
    if (!MAPBOX_TOKEN) {
      console.error('Mapbox token is missing!');
      return;
    }
    mapboxgl.accessToken = MAPBOX_TOKEN;

    map = new mapboxgl.Map({
      container: 'map',
      style: 'mapbox://styles/mapbox/dark-v11',
      center: [-83.21, 42.32],
      zoom: 12,
      pitch: 0
    });

    map.addControl(new mapboxgl.NavigationControl(), 'top-right');
    map.addControl(new mapboxgl.FullscreenControl(), 'top-right');

    map.on('load', () => {
      map.addSource('boundary', { type: 'geojson', data: boundaryData });
      map.addLayer({
        id: 'boundary-fill', type: 'fill', source: 'boundary',
        paint: { 'fill-color': '#533483', 'fill-opacity': 0.05 }
      });
      map.addLayer({
        id: 'boundary-line', type: 'line', source: 'boundary',
        paint: { 'line-color': '#533483', 'line-width': 2, 'line-opacity': 0.7, 'line-dasharray': [2, 2] }
      });

      shownGeometry = activeGeometry();
      map.addSource('precincts', { type: 'geojson', data: GEOMETRIES[shownGeometry] });
      map.addLayer({
        id: 'precinct-fill', type: 'fill', source: 'precincts',
        paint: { 'fill-color': '#333333', 'fill-opacity': 0.7 }
      });
      map.addLayer({
        id: 'precinct-line', type: 'line', source: 'precincts',
        paint: { 'line-color': '#ffffff', 'line-width': 2, 'line-opacity': 0.8 }
      });
      map.addLayer({
        id: 'precinct-labels', type: 'symbol', source: 'precincts',
        layout: {
          'text-field': ['get', 'PRECINCT'],
          'text-size': 11,
          'text-anchor': 'center',
          'text-font': ['DIN Pro Bold', 'Arial Unicode MS Bold']
        },
        paint: { 'text-color': '#ffffff', 'text-halo-color': '#000000', 'text-halo-width': 1.5 }
      });

      refresh();

      map.on('click', 'precinct-fill', (e) => showPopup(e.lngLat, e.features[0].properties.PRECINCT, e.features[0].properties));
      map.on('mouseenter', 'precinct-fill', () => { map.getCanvas().style.cursor = 'pointer'; });
      map.on('mouseleave', 'precinct-fill', () => { map.getCanvas().style.cursor = ''; });
    });
  }

  // ---------------------------------------------------------------------------
  // Controls
  // ---------------------------------------------------------------------------

  function fillYearSelect(select, value) {
    select.innerHTML = YEARS.map(y => `<option value="${y}">${escapeHtml(ELECTIONS[y].label)}</option>`).join('');
    select.value = value;
  }

  function fillRaceSelect(select, year, value) {
    const groups = {};
    for (const [key, race] of Object.entries(ELECTIONS[year].races)) {
      (groups[race.category] = groups[race.category] || []).push([key, race.race_name]);
    }
    select.innerHTML = Object.entries(groups).map(([cat, races]) =>
      `<optgroup label="${escapeHtml(cat)}">` +
      races.map(([key, name]) => `<option value="${key}">${escapeHtml(name)}</option>`).join('') +
      '</optgroup>'
    ).join('');
    select.value = value;
  }

  function fillCandidateSelect(select, sel, placeholder) {
    const race = getRace(sel);
    select.innerHTML = `<option value="">${placeholder}</option>` +
      (race ? race.candidates.map(c => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('') : '');
    select.value = sel.candidate || '';
  }

  // Wire a year/race/candidate trio to a selection object.
  function bindSelection(yearEl, raceEl, candEl, getSel, placeholder) {
    const sync = () => {
      const sel = getSel();
      fillYearSelect(yearEl, sel.year);
      fillRaceSelect(raceEl, sel.year, sel.race);
      fillCandidateSelect(candEl, sel, placeholder);
    };
    yearEl.addEventListener('change', () => {
      const sel = getSel();
      sel.year = yearEl.value;
      sel.race = DEFAULT_RACE[sel.year] || Object.keys(ELECTIONS[sel.year].races)[0];
      sel.candidate = null;
      sync();
      refresh();
    });
    raceEl.addEventListener('change', () => {
      const sel = getSel();
      sel.race = raceEl.value;
      sel.candidate = null;
      fillCandidateSelect(candEl, sel, placeholder);
      refresh();
    });
    candEl.addEventListener('change', () => {
      getSel().candidate = candEl.value || null;
      refresh();
    });
    sync();
  }

  function setupEventListeners() {
    bindSelection(
      document.getElementById('year-select'),
      document.getElementById('race-select'),
      document.getElementById('candidate-select'),
      () => current,
      'Precinct winner'
    );
    bindSelection(
      document.getElementById('compare-year-1'),
      document.getElementById('compare-race-1'),
      document.getElementById('compare-candidate-1'),
      () => compare1,
      'Select candidate...'
    );
    bindSelection(
      document.getElementById('compare-year-2'),
      document.getElementById('compare-race-2'),
      document.getElementById('compare-candidate-2'),
      () => compare2,
      'Select candidate...'
    );

    document.getElementById('compare-metric').addEventListener('change', (e) => {
      compareMetric = e.target.value;
      refresh();
    });

    const compareToggle = document.getElementById('compare-toggle');
    const compareToggleText = document.getElementById('compare-toggle-text');
    const normalSelector = document.getElementById('normal-selector');
    const compareSelectors = document.getElementById('compare-selectors');
    compareToggle.addEventListener('click', () => {
      compareMode = !compareMode;
      compareToggleText.textContent = compareMode ? 'Disable Compare Mode' : 'Enable Compare Mode';
      compareToggle.classList.toggle('active', compareMode);
      normalSelector.classList.toggle('hidden', compareMode);
      compareSelectors.classList.toggle('hidden', !compareMode);
      refresh();
    });

    // Sidebar toggle (mobile)
    const sidebar = document.getElementById('sidebar');
    document.getElementById('sidebar-toggle').addEventListener('click', () => sidebar.classList.add('open'));
    document.getElementById('sidebar-close').addEventListener('click', () => sidebar.classList.remove('open'));

    // Render sidebar content even before the map finishes loading.
    updateLegend();
    updateVoteTotals();
  }

  let domReady = false;
  let mapboxReady = false;

  function tryInit() {
    if (domReady && mapboxReady) {
      try {
        initMap();
      } catch (e) {
        console.error('Map init error:', e);
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      domReady = true;
      setupEventListeners();
      tryInit();
    });
  } else {
    domReady = true;
    setupEventListeners();
    tryInit();
  }

  const link = document.createElement('link');
  link.rel = 'stylesheet';
  link.href = 'https://api.mapbox.com/mapbox-gl-js/v3.8.0/mapbox-gl.css';
  document.head.appendChild(link);

  const script = document.createElement('script');
  script.src = 'https://api.mapbox.com/mapbox-gl-js/v3.8.0/mapbox-gl.js';
  script.onload = () => {
    mapboxReady = true;
    tryInit();
  };
  script.onerror = (e) => console.error('Failed to load Mapbox GL JS:', e);
  document.head.appendChild(script);
</script>
